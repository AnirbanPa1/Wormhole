# =================================================================
# Wormhole Environment Configuration (web backend / Prisma)
# =================================================================
# This is a TEMPLATE. Copy values into the per-app env files:
#   packages/database/.env   (Prisma: DATABASE_URL, DIRECT_URL)
#   apps/mobile/.env        (mobile: EXPO_PUBLIC_*)
#   apps/web/.env.local     (web: SUPABASE_*, DATABASE_URL, ...)
# Never commit real credentials to this file.

# ---- Supabase (PostgreSQL + Storage + Auth) ----
# Create a project at https://supabase.com, then copy credentials from:
#   Project Settings > Database > Connection string (Prisma/pooler)
#   Project Settings > API Keys (anon, service_role)
#   Storage > Create a private bucket named "audio"
#
# DATABASE_URL should use the Supabase connection POOLER (port 6543) for
# apps to avoid exhausting connection slots.
# DIRECT_URL should use the direct connection (port 5432) for Prisma CLI
# migrations only (npx prisma migrate dev / db push).

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="audio"

DATABASE_URL="postgresql://postgres.YOUR_REF.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_REF.supabase.co:5432/postgres"

# Storage backend: "supabase" (default) or "local" (web falls back to disk)
STORAGE_TYPE="supabase"
STORAGE_LOCAL_PATH="./storage"

# ---- Authentication (web) ----
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# ---- App Metadata ----
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
